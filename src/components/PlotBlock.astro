---
import RichText from "./RichText.astro";
import type { PlotMarker, PlotSeries } from "@/data/content";
import type { Lang } from "@/data/site";

interface Props {
  caption: Record<Lang, string>;
  xLabel: string;
  yLabel: string;
  xDomain?: [number, number];
  yDomain?: [number, number];
  logX?: boolean;
  logY?: boolean;
  series: PlotSeries[];
  markers?: PlotMarker[];
  lang: Lang;
}

const {
  caption,
  xLabel,
  yLabel,
  xDomain,
  yDomain,
  logX = false,
  logY = false,
  series,
  markers = [],
  lang
} = Astro.props;

const zoomLabels = {
  open: { es: "Ampliar gráfica", eu: "Handitu grafikoa", en: "Expand plot" },
  close: { es: "Cerrar", eu: "Itxi", en: "Close" }
};

const width = 640;
const height = 360;
const margin = { top: 18, right: 22, bottom: 52, left: 70 };
const plotW = width - margin.left - margin.right;
const plotH = height - margin.top - margin.bottom;

const toAxis = (value: number, log: boolean) => (log ? Math.log10(value) : value);

function extent(values: number[], log: boolean): [number, number] {
  const finite = values.filter((v) => Number.isFinite(v) && (!log || v > 0));
  const lo = Math.min(...finite);
  const hi = Math.max(...finite);
  if (log) {
    const [l0, l1] = [Math.log10(lo), Math.log10(hi)];
    const logPad = (l1 - l0 || 1) * 0.06;
    return [l0 - logPad, l1 + logPad];
  }
  const pad = (hi - lo || Math.abs(hi) || 1) * 0.06;
  return [lo - pad, hi + pad];
}

const allPoints = [...series.flatMap((s) => s.points), ...markers.map((m) => [m.x, m.y])];
const [x0, x1] = xDomain
  ? [toAxis(xDomain[0], logX), toAxis(xDomain[1], logX)]
  : extent(allPoints.map((p) => p[0]), logX);
const [y0, y1] = yDomain
  ? [toAxis(yDomain[0], logY), toAxis(yDomain[1], logY)]
  : extent(allPoints.map((p) => p[1]), logY);

const sx = (x: number) => margin.left + ((toAxis(x, logX) - x0) / (x1 - x0)) * plotW;
const sy = (y: number) => margin.top + (1 - (toAxis(y, logY) - y0) / (y1 - y0)) * plotH;

function niceStep(span: number, target: number) {
  const raw = span / target;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const norm = raw / mag;
  return (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
}

function linearTicks(lo: number, hi: number, target: number) {
  const step = niceStep(hi - lo, target);
  const ticks: number[] = [];
  for (let v = Math.ceil(lo / step) * step; v <= hi + step * 1e-9; v += step) {
    ticks.push(Math.abs(v) < step * 1e-9 ? 0 : v);
  }
  return ticks;
}

const superscripts: Record<string, string> = {
  "-": "⁻",
  "0": "⁰",
  "1": "¹",
  "2": "²",
  "3": "³",
  "4": "⁴",
  "5": "⁵",
  "6": "⁶",
  "7": "⁷",
  "8": "⁸",
  "9": "⁹"
};
const powerLabel = (e: number) =>
  `10${String(e)
    .split("")
    .map((c) => superscripts[c])
    .join("")}`;
const numberLabel = (v: number) => String(Number(v.toPrecision(6)));

const axisTicks = (lo: number, hi: number, log: boolean, target: number) =>
  log
    ? Array.from({ length: Math.floor(hi) - Math.ceil(lo) + 1 }, (_, i) => {
        const e = Math.ceil(lo) + i;
        return { value: 10 ** e, label: powerLabel(e) };
      })
    : linearTicks(lo, hi, target).map((value) => ({ value, label: numberLabel(value) }));

const xTicks = axisTicks(x0, x1, logX, 7);
const yTicks = axisTicks(y0, y1, logY, 6);

const visible = (p: number[]) =>
  Number.isFinite(p[0]) && Number.isFinite(p[1]) && (!logX || p[0] > 0) && (!logY || p[1] > 0);

// Keep far-away values finite so clipped paths still render cleanly.
const clampPx = (v: number) => Math.max(-2000, Math.min(2000, v));
const pathFor = (points: number[][]) =>
  points
    .filter(visible)
    .map((p, i) => `${i === 0 ? "M" : "L"}${clampPx(sx(p[0])).toFixed(1)} ${clampPx(sy(p[1])).toFixed(1)}`)
    .join(" ");

const inside = (p: number[]) => {
  const px = sx(p[0]);
  const py = sy(p[1]);
  return px >= margin.left - 1 && px <= width - margin.right + 1 && py >= margin.top - 1 && py <= height - margin.bottom + 1;
};

const hash = (text: string) =>
  Array.from(text).reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36);
const clipId = `plot-clip-${hash(caption.en + series.length + xLabel + yLabel)}`;
const zeroY = !logY && y0 < 0 && y1 > 0;
---

<figure class="diagram-figure plot-figure">
  <div class="diagram-canvas">
    <button
      class="diagram-zoom-button"
      type="button"
      aria-label={zoomLabels.open[lang]}
      title={zoomLabels.open[lang]}
      data-diagram-zoom
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="6" />
        <path d="m16 16 5 5" />
      </svg>
    </button>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={caption[lang]}>
      <defs>
        <clipPath id={clipId}>
          <rect x={margin.left} y={margin.top} width={plotW} height={plotH} />
        </clipPath>
      </defs>
      <rect class="diagram-bg" x="0" y="0" width={width} height={height} rx="6" />
      {xTicks.map((tick) => (
        <g>
          <line class="plot-grid" x1={sx(tick.value)} x2={sx(tick.value)} y1={margin.top} y2={height - margin.bottom} />
          <text class="plot-tick" x={sx(tick.value)} y={height - margin.bottom + 20} text-anchor="middle">{tick.label}</text>
        </g>
      ))}
      {yTicks.map((tick) => (
        <g>
          <line class="plot-grid" x1={margin.left} x2={width - margin.right} y1={sy(tick.value)} y2={sy(tick.value)} />
          <text class="plot-tick" x={margin.left - 8} y={sy(tick.value) + 5} text-anchor="end">{tick.label}</text>
        </g>
      ))}
      {zeroY && (
        <line class="plot-zero" x1={margin.left} x2={width - margin.right} y1={sy(0)} y2={sy(0)} />
      )}
      <rect class="plot-frame" x={margin.left} y={margin.top} width={plotW} height={plotH} />
      <g clip-path={`url(#${clipId})`}>
        {series.map((s) =>
          s.style === "points" ? null : (
            <path
              class:list={["plot-line", `plot-tone-${s.tone ?? "accent"}`, { "plot-dashed": s.style === "dashed" }]}
              d={pathFor(s.points)}
            />
          )
        )}
      </g>
      {series.map((s) =>
        s.style === "points" || s.style === "line-points"
          ? s.points
              .filter((p) => visible(p) && inside(p))
              .map((p) => (
                <circle class:list={["plot-dot", `plot-tone-${s.tone ?? "accent"}`]} cx={sx(p[0])} cy={sy(p[1])} r="4.5" />
              ))
          : null
      )}
      {markers.filter((m) => inside([m.x, m.y])).map((m) => (
        <g>
          <circle class:list={["plot-marker", `plot-tone-${m.tone ?? "ink"}`]} cx={sx(m.x)} cy={sy(m.y)} r="6" />
          {m.label && (
            <text
              class="plot-marker-label"
              x={sx(m.x) + (sx(m.x) > width - 150 ? -10 : 10)}
              y={sy(m.y) - 10}
              text-anchor={sx(m.x) > width - 150 ? "end" : "start"}
            >
              {m.label}
            </text>
          )}
        </g>
      ))}
      <text class="plot-axis-label" x={margin.left + plotW / 2} y={height - 10} text-anchor="middle">{xLabel}</text>
      <text
        class="plot-axis-label"
        x="16"
        y={margin.top + plotH / 2}
        text-anchor="middle"
        transform={`rotate(-90 16 ${margin.top + plotH / 2})`}
      >
        {yLabel}
      </text>
    </svg>
  </div>
  <ul class="plot-legend">
    {series.map((s) => (
      <li>
        <span
          class:list={[
            "plot-swatch",
            `plot-tone-${s.tone ?? "accent"}`,
            { "plot-swatch-dashed": s.style === "dashed", "plot-swatch-dot": s.style === "points" }
          ]}
          aria-hidden="true"
        />
        <RichText text={s.label[lang]} lang={lang} />
      </li>
    ))}
  </ul>
  <figcaption><RichText text={caption[lang]} lang={lang} /></figcaption>
  <dialog class="diagram-dialog" data-diagram-dialog>
    <div class="diagram-dialog-panel">
      <div class="diagram-dialog-head">
        <strong>{zoomLabels.open[lang]}</strong>
        <button
          class="diagram-dialog-close"
          type="button"
          aria-label={zoomLabels.close[lang]}
          title={zoomLabels.close[lang]}
          data-diagram-close
        >
          ×
        </button>
      </div>
      <div class="diagram-dialog-art" data-diagram-dialog-art></div>
      <p class="diagram-dialog-caption">
        <RichText text={caption[lang]} lang={lang} />
      </p>
    </div>
  </dialog>
</figure>

<script>
  const setupDiagramZoom = () => {
    const win = window as Window & { __diagramZoomSetup?: boolean };

    if (win.__diagramZoomSetup) return;
    win.__diagramZoomSetup = true;

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const zoomButton = target.closest("[data-diagram-zoom]");
      if (zoomButton) {
        const figure = zoomButton.closest(".diagram-figure");
        const dialog = figure?.querySelector<HTMLDialogElement>("[data-diagram-dialog]");
        const art = figure?.querySelector("[data-diagram-dialog-art]");
        const svg = figure?.querySelector(".diagram-canvas > svg");

        if (!dialog || !art || !svg) return;

        art.replaceChildren(svg.cloneNode(true));
        dialog.showModal();
        return;
      }

      const closeButton = target.closest("[data-diagram-close]");
      if (closeButton) {
        closeButton.closest<HTMLDialogElement>("dialog")?.close();
      }
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof HTMLDialogElement && event.target.matches("[data-diagram-dialog]")) {
        event.target.close();
      }
    });
  };

  setupDiagramZoom();
</script>
